# Only needed if you deploy the frontend SEPARATELY from the backend
# (e.g. frontend on Netlify/Vercel, backend on Railway).
#
# Set this to your backend's live URL + /api, e.g.:
# VITE_API_URL=https://apna-backend.up.railway.app/api
#
# If you deploy them TOGETHER as one Railway service (the backend serves
# client/dist directly — see server's static-file serving), leave this
# unset; the app will use a relative "/api" path automatically.

VITE_API_URL=
