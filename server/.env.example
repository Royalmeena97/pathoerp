# Copy this file to .env (or set these as real environment variables) and
# fill in your own local Postgres connection string.
#
# On Railway: once you attach a Postgres plugin to this service, Railway
# injects DATABASE_URL automatically — you don't need to set this yourself
# in production.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/pathoerp

# Railway's managed Postgres needs SSL but uses a self-signed cert, which the
# server already handles. If you're running a plain local Postgres with no
# SSL configured, set this to "false".
PGSSL=false

# Comma-separated list of frontend origins allowed to call this API, e.g.
# ALLOWED_ORIGINS=https://mypathoerp.com,https://www.mypathoerp.com
# Leave unset for local development (allows any origin). ALWAYS set this in
# production once you know your frontend's real URL.
ALLOWED_ORIGINS=
